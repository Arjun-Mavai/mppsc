# Site URL
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Database (Turso)
TURSO_DATABASE_URL="libsql://your-database-name.turso.io"
TURSO_AUTH_TOKEN="your-turso-auth-token"

# Logging
NEXT_PUBLIC_ENABLE_LOGGING=true

# Auth
JWT_SECRET="your-jwt-secret"
ADMIN_SECRET_KEY="your-admin-secret-key"

# Upstash Redis (For Rate Limiting/Cache)
UPSTASH_REDIS_REST_URL="https://your-redis-url.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-redis-token"

# Email (Resend)
RESEND_API_KEY="re_your_api_key"
RESEND_FROM_EMAIL="noreply@yourdomain.com"
EMAIL_FROM_NAME="Your App Name"

# Payment (Razorpay)
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_your_key_id"
RAZORPAY_KEY_SECRET="your_key_secret"

# Rate Limiting
RATE_LIMIT_ENABLED=false

# Sentry
NEXT_PUBLIC_SENTRY_DSN="https://your-sentry-dsn"
SENTRY_ORG="your-sentry-org"
SENTRY_PROJECT="your-sentry-project"

# Meta WhatsApp API
VERIFY_TOKEN="your_verify_token"
PHONE_NUMBER_ID="your_phone_number_id"
WABA_ID="your_waba_id"
WHATSAPP_TOKEN="your_whatsapp_token"

# Telegram Bot
TELEGRAM_BOT_TOKEN="your_bot_token"
TELEGRAM_CHAT_ID="your_chat_id"

# Telegram Telemetry Event Bot (mppsc_events_bot)
TELEGRAM_EVENTS_BOT_TOKEN="8412751496:AAF3AUYupX05y-msVrWHJR4uVfelF1Pb2ts"
TELEGRAM_EVENTS_CHAT_ID="" # Optional (falls back to TELEGRAM_CHAT_ID if empty)
TELEGRAM_EVENTS_DETAILED=true # Set to false to log only high-value events (such as checkout/clicks)

# Other APIs
NUMVERIFY_API_KEY="your_numverify_api_key"
MAILS_SO_API_KEY="your_mails_so_api_key"

# Feature Flags
USE_PROD_DB=false
NEXT_PUBLIC_DISABLE_CONTENT_PROTECTION=false

# Realtime Chat WebSocket URL
NEXT_PUBLIC_WS_URL="wss://websocket-realtime-chat-render.onrender.com/ws"

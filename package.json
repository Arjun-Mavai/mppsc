{
  "name": "my-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbo",
    "build": "next build",
    "start": "next start",
    "start:debug": "next start --inspect",
    "lint": "eslint",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:remote": "USE_PROD_DB=true drizzle-kit migrate",
    "db:push": "node scripts/safe-db-push.mjs",
    "db:pull": "npx tsx scripts/db-pull.ts",
    "db:studio": "drizzle-kit studio",
    "db:seed:mains": "npx tsx src/scripts/seed-mains.ts",
    "db:seed:mains:remote": "USE_PROD_DB=true npx tsx src/scripts/seed-mains.ts",
    "db:fix:mains-cols": "USE_PROD_DB=true node scripts/fix-mains-exam-type-columns.mjs",
    "db:ensure:pyq": "USE_PROD_DB=true node scripts/ensure-mains-pyq-tables.mjs",
    "db:setup:mains:remote": "USE_PROD_DB=true sh -c 'USE_PROD_DB=true npm run db:migrate && USE_PROD_DB=true node scripts/fix-mains-exam-type-columns.mjs && USE_PROD_DB=true node scripts/ensure-mains-pyq-tables.mjs && USE_PROD_DB=true npx tsx src/scripts/seed-mains.ts'",
    "db:sync:mains:from-local": "npx tsx scripts/sync-mains-local-to-remote.ts",
    "db:apply:mains": "node scripts/apply-mains-schema.mjs",
    "format": "prettier --write .",
    "report:pyq-2026": "node scripts/pyq-2026-corpus-overlap.mjs",
    "test:payment": "npx tsx scripts/test-payment-resolve.ts",
    "mains:overview": "npx tsx scripts/mains-test-overview.ts",
    "postinstall": "pnpm audit --prod || echo 'Review security vulnerabilities.'",
    "security-check": "pnpm audit"
  },
  "dependencies": {

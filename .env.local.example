# Development Environment Variables
# Copy this file to .env.local (for local development only)

# IMPORTANT: Do NOT commit .env.local to git (it's in .gitignore)

# ═══════════════════════════════════════════════════════════════════════════════
# CONTENT PROTECTION TOGGLE (Development Only)
# ═══════════════════════════════════════════════════════════════════════════════

# Set to 'true' to disable content protection features while developing locally
# When disabled:
#   ✅ All content visible (no paywall)
#   ✅ Can select/copy freely
#   ✅ Good for UI/UX testing
#
# IMPORTANT: Leave this unset or 'false' for production!
# 
# Usage:
#   1. For development (disable protection):
#      NEXT_PUBLIC_DISABLE_CONTENT_PROTECTION=true
#   
#   2. For testing production behavior:
#      NEXT_PUBLIC_DISABLE_CONTENT_PROTECTION=false
#      (or just comment out this line)

NEXT_PUBLIC_DISABLE_CONTENT_PROTECTION=true

# ═══════════════════════════════════════════════════════════════════════════════
# Example: How to use this file
# ═══════════════════════════════════════════════════════════════════════════════

# SCENARIO 1: Development (all features disabled)
#   ✅ Set NEXT_PUBLIC_DISABLE_CONTENT_PROTECTION=true
#   ✅ Run: npm run dev
#   ✅ All content visible, can select/copy
#   Use this when: Building UI, testing UX, debugging components
#
# SCENARIO 2: Testing Production Behavior Locally
#   ✅ Comment out: # NEXT_PUBLIC_DISABLE_CONTENT_PROTECTION=true
#   ✅ Run: npm run dev
#   ✅ All protection features active (copy blocked, paywall shows)
#   Use this when: Before deploying, testing security, verifying paywall works
#
# SCENARIO 3: Production
#   ✅ Don't set this variable at all
#   ✅ Protection always ON
#   ✅ All security features active

# Realtime Chat WebSocket URL
NEXT_PUBLIC_WS_URL="wss://websocket-realtime-chat-render.onrender.com/ws"
